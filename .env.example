# ==============================================================================
# M.M BOOK HOUSE MALDA - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Online Payment Gateways (Item 25, 46)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# Fast2SMS & Gupshup Notifications (Item 44)
FAST2SMS_API_KEY=your_fast2sms_api_key
GUPSHUP_API_KEY=your_gupshup_api_key
GUPSHUP_APP_NAME=MMBookHouse

# Meta Conversions API (CAPI) (Item 49)
META_CAPI_ACCESS_TOKEN=your_meta_capi_access_token
META_PIXEL_ID=your_meta_pixel_id

# Upstash Redis Concurrency Locks & Cache (Optional / Recommended for Serverless Multi-instance)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# Application URL
NEXT_PUBLIC_SITE_URL=https://mmbookhouse.com
