# ---------------------------------------------------------------------------
# mmbookhouse — environment variables
# Copy to .env.local for local development. On Vercel add the same names in
# Project -> Settings -> Environment Variables (Production AND Preview).
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never NEXT_PUBLIC_

# Public site URL (used in auth redirects, sitemap, invoices)
NEXT_PUBLIC_SITE_URL=https://mmbookhouse.vercel.app

# Admin: comma separated e-mails that become Super Admin on first admin login.
# The account must exist (sign up on the site first) and its e-mail be confirmed.
ADMIN_OWNER_EMAILS=owner@example.com

# Optional: direct Postgres URL, only for `npm run db:migrate` and backups
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres

# Optional (later): payments / SMS / WhatsApp — features stay disabled until set
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# SMS_PROVIDER_API_KEY=

# Backups (GitHub Actions workflow) — see supabase/DISASTER_RECOVERY_RUNBOOK.md
# GITHUB_REPOSITORY=owner/repo
# GITHUB_BACKUP_REF=main
# GITHUB_BACKUP_WORKFLOW=database-backup.yml
# GITHUB_BACKUP_TOKEN=

# Set to "true" only after enabling the Google provider in Supabase (shows the Google button)
# NEXT_PUBLIC_GOOGLE_LOGIN=true

# ---- Notifications (each channel stays off until its keys are set) ----
# Email: use Resend OR any SMTP (Brevo, Gmail app password, ...)
EMAIL_FROM="mmbookhouse <orders@yourdomain.com>"
# RESEND_API_KEY=
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# WhatsApp Cloud API (Meta) - needs an approved template with 4 body variables
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=mm_order_update
# WHATSAPP_TEMPLATE_LANG=en
# SMS via Fast2SMS DLT route - needs a DLT-approved template with 3 variables
# FAST2SMS_API_KEY=
# FAST2SMS_SENDER_ID=
# FAST2SMS_DLT_TEMPLATE_ID=
# Protects /api/cron/notifications (Vercel Cron sends it automatically)
# CRON_SECRET=

# MCP server (/api/mcp) for the Gemini app "custom app" connector. 32+ random characters.
# Changing it disconnects every connected app.
# MCP_OAUTH_SECRET=
# Extra allowed OAuth redirect prefixes, comma separated (Gemini relay and localhost are built in)
# MCP_EXTRA_REDIRECT_PREFIXES=
